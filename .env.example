AI_PROVIDER=mimo
AI_BASE_URL=https://api.xiaomimimo.com/v1
AI_MODEL=mimo-v2-flash
MIMO_API_KEY=your-mimo-key-here

# OpenAI fallback, only needed when AI_PROVIDER=openai.
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_MS=30000
# Optional: use this when your machine cannot reach https://api.openai.com/v1 directly.
# OPENAI_BASE_URL=https://api.openai.com/v1
# Optional: force Node/OpenAI SDK traffic through a local proxy.
# OPENAI_PROXY=http://127.0.0.1:7897
PORT=8787

# Supabase Auth + Postgres sync. Leave empty to use local file fallback.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# iOS/Capacitor cannot use Vite's /api proxy after packaging.
# Set this to the LAN address of the computer running `npm run dev:api`,
# then rebuild the IPA. Example: http://172.20.10.4:8787
VITE_API_BASE_URL=http://YOUR_MAC_LAN_IP:8787
